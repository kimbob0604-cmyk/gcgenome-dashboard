 <label>랩텍 순이익률(%)<input type="number" id="rM" value="20" step="5"></label>
 <label>지분율(%)<input type="number" id="rE" value="31" step="1"></label>
 <label>성공확률(%)<input type="number" id="rP" value="35" step="5"></label></div>
 <div id="rOut"></div><p class="cap" style="margin-top:6px">시총 애드 = (로열티 + 지분법) × PER 20배 ÷ 1.75(연 15%, 4년 할인) × 성공확률. 환율 1,400원.</p>`)}</div>
 ${card('시나리오 표 (억원, 연간)','랩텍 몫 60%, 랩텍 순이익률 15~25%',`<div class="tw"><table><thead><tr><th>경로</th><th>연도</th><th class="n">미국 매출</th><th class="n">로열티 5%</th><th class="n">8%</th><th class="n">10%</th><th class="n">지분법 31%</th></tr></thead><tbody>
 <tr><td>회사 목표</td><td>2028</td><td class="n">$30M = 420</td><td class="n">13</td><td class="n">20</td><td class="n">25</td><td class="n">12~20</td></tr>
 <tr><td>회사 목표</td><td>2030</td><td class="n">$100M = 1,400</td><td class="n">42</td><td class="n"><b>67</b></td><td class="n">84</td><td class="n">39~65</td></tr>
 <tr><td>보수</td><td>2028</td><td class="n">$5M = 70</td><td class="n">2</td><td class="n">3</td><td class="n">4</td><td class="n">2~3</td></tr>
 <tr><td>보수</td><td>2030</td><td class="n">$30M = 420</td><td class="n">13</td><td class="n">20</td><td class="n">25</td><td class="n">12~20</td></tr></tbody></table></div>
 <p class="cap" style="margin-top:8px">2026E(키움) 매출 347억·영업이익 28억 대비 회사 목표 2030·8%면 매출 +19%, 영업이익 3.4배. 로열티율 근거: Freenome→Exact 0~10%, 9월 가이드 8% 가정. GC랩텍 재무(부채 > 자산 표기)는 확인 필요.</p>`)}
 </section>`;

 /* 꿈의 지도 */
 H+=`<section class="page" id="dream"><div class="page-head"><h1>꿈의 지도</h1><p>바이오는 꿈을 파는 곳 · 현실성 있는 꿈과 결말 · 시총 애드 기준(억원)</p></div>
 <div class="kpis">${kpi('지금 시총',nf(MC)+'억','미국은 거의 0으로 반영','dream')}${kpi('미국 사업가치(100%)','7,000억~1.4조','2030 $1억 × 매출 5~10배','dream')}${kpi('연결 편입 시 귀속 애드','+2,200~4,400억','현재가치, 55% 귀속','dream')}${kpi('다중암까지 가면','+1조원대','2032 $3억 × 8배, 현재가치','dream')}</div>
 ${card('왜 현실성 있는 꿈인가','10월 노션 리서치 + 컨콜',`<ul class="def">
 <li><b>모델은 증명됨:</b> 가던트 Shield(대장암 혈액검사) 2026 가이던스 27~28.5만 건, $218~230M → 10~20배면 3.1~6.3조원</li>
 <li><b>췌장암은 빈 시장:</b> 평균위험 대상 표준 혈액 선별검사 없음. 고위험군은 MRI·EUS 감시라 비싸고 침습적 → <b>혈액으로 먼저 거르는 방식</b>이 유력</li>
 <li><b>물량이 과하지 않음:</b> $1억 ÷ 건당 $1,500 = 연 6.7만 건 = Shield 올해 물량의 4분의 1. 미국 신규 환자 대장암 15.9만 · 췌장암 6.75만 명</li>
 <li><b>가던트가 지씨지놈을 볼 이유:</b> 자체 Shield MCD 췌장암 민감도 약 68% vs PancSight 1·2기 87.5~91.7%. 경쟁사 ClearNote는 가던트와 직접 경쟁 → 기술을 넘길 이유 없음. 지씨지놈은 국내에서 Guardant360을 팔아 온 관계</li>
 <li><b>플랫폼 확장:</b> 췌장암 다음 간암·유방암·폐암을 2년에 하나씩 → 파트너십 장기화</li></ul>`)}
 ${card('관문을 넘을 때마다 붙는 시총','연결 편입(55%)·매출 5배 기준 현재가치 2,200억 × 단계별 성공확률(내 추정). 막대 = 지금 시총 + 미국 애드',`<div class="ch-box tall"><canvas id="cDream"></canvas></div>
 <div class="tw"><table><thead><tr><th>단계</th><th class="n">성공확률</th><th class="n">애드(5배)</th><th class="n">애드(10배)</th><th>확인할 숫자</th></tr></thead><tbody>
 <tr><td>지금(데이터 대기)</td><td class="n">20%</td><td class="n">+440</td><td class="n">+880</td><td class="d">-</td></tr>
 <tr><td>미국 1,500명 결과 양호</td><td class="n">30%</td><td class="n">+660</td><td class="n">+1,320</td><td class="d">특이도 98% 이상에서 1·2기 민감도 80% 후반~90%, 당뇨·췌장염·낭종에서 위양성 낮음</td></tr>
 <tr><td>BDD 지정</td><td class="n">40%</td><td class="n">+880</td><td class="n">+1,760</td><td class="d">신청 후 60일</td></tr>
 <tr><td>가던트 본계약</td><td class="n">55%</td><td class="n">+1,210</td><td class="n">+2,420</td><td class="d">배분 비율, 계약금·마일스톤</td></tr>
 <tr><td>LDT 출시·급여</td><td class="n">75%</td><td class="n">+1,650</td><td class="n">+3,300</td><td class="d">MolDX 기술평가, 수가</td></tr>
 <tr><td>미국 매출 $30M</td><td class="n">90%</td><td class="n">+1,980</td><td class="n">+3,960</td><td class="d">분기 검사 건수</td></tr></tbody></table></div>`)}
 ${card('꿈의 크기별 시총 애드','2030 미국 췌장암 $1억 기준, 할인 연 15%(÷1.75)',`<div class="tw"><table><thead><tr><th>꿈의 크기</th><th class="n">미국 사업가치</th><th class="n">귀속</th><th class="n">2030 애드</th><th class="n">현재가치 애드</th></tr></thead><tbody>
 <tr><td>로열티 + 지분 · 5배</td><td class="n">7,000억</td><td class="n">약 35%</td><td class="n">+2,450억</td><td class="n">+1,400억</td></tr>
 <tr><td><b>연결 편입 · 5배</b></td><td class="n">7,000억</td><td class="n">55%</td><td class="n"><b>+3,850억</b></td><td class="n"><b>+2,200억</b></td></tr>
 <tr><td>연결 편입 · 10배</td><td class="n">1.4조</td><td class="n">55%</td><td class="n">+7,700억</td><td class="n">+4,400억</td></tr>
 <tr><td>다중암 $300M(2032) · 8배 · 연결</td><td class="n">3.4조</td><td class="n">55%</td><td class="n">+1.85조</td><td class="n">+1.0조</td></tr>
 <tr><td class="muted">참고: Shield $224M × 10~20배</td><td class="n muted">3.1~6.3조</td><td></td><td></td><td></td></tr></tbody></table></div>
 <div class="note" style="margin-top:10px"><b>현실 체크:</b> 연결 편입이 안 되면 귀속이 35%로 줄고, 로열티만이면 애드는 +160~600억. 공개된 특이도는 95.4%라 98%까지 올리는 게 첫 관문. 꿈의 전제는 '미국 데이터 → 가던트 본계약 → 연결 편입' 세 가지가 함께 가는 것.</div>`)}
 </section>`;
 /* 밸류 */
 H+=`<section class="page" id="val"><div class="page-head"><h1>밸류에이션</h1><p>EV/매출 방식. 숫자를 바꾸면 바로 계산됩니다</p></div>
 <div class="kpis">${kpi('지금 EV',nf(ev)+'억','시총 '+nf(MC)+' − 순현금 '+NETCASH,'val')}${kpi('EV/최근 4분기 매출',nf(ev/ttmRev,1)+'배','LTM P/S 7배(삼성, 11/2)','val')}${kpi('PER 2026E',nf(PX/258,1)+'배','키움 EPS 258원','val')}${kpi('PBR',nf(PX/3377,2)+'배','BPS 3,377원','val')}</div>
 ${card('시나리오','2027E 매출 410억(2026E 347억 × 1.18, 회사 "15~20% 성장")',`<div class="ch-box"><canvas id="cV"></canvas></div><div class="tw"><table><thead><tr><th>시나리오</th><th>가정</th><th class="n">시총(주가)</th><th class="n">시총 애드</th></tr></thead><tbody>
 <tr><td class="down"><b>Bear</b></td><td>국내 성장 둔화. 2026E 매출 347억 × EV/매출 2.5배 + 순현금 430억 (상장 이후 저점 부근)</td><td class="n">1,300억(5,500원)</td><td class="n down">-530억</td></tr>
 <tr><td><b>Base</b></td><td>미국 0원. 2027E 410억 × 4.0배(지금 수준) + 430억</td><td class="n">2,070억(8,800원)</td><td class="n up">+240억</td></tr>
 <tr><td class="up"><b>Bull</b></td><td>BDD 지정·가던트 계약으로 미국 가시화. 410억 × 6.0배(삼성 LTM 7배 아래) + 430억</td><td class="n">2,890억(12,200원)</td><td class="n up">+1,060억</td></tr></tbody></table></div>`)}
 ${card('직접 계산','',`<div class="fin-in">
 <label>2027E 매출(억)<input type="number" id="vR" value="410"></label>
 <label>EV/매출(배)<input type="number" id="vM" value="4" step="0.5"></label>
 <label>순현금(억)<input type="number" id="vC" value="430"></label>
 <label>미국 옵션 가치(억)<input type="number" id="vU" value="0" step="100"></label></div>
 <div>적정 시총 <span class="big" id="vOut"></span> <span id="vUp"></span></div>
 <p class="cap" style="margin-top:6px">미국 옵션 예: 2030 GC랩텍 매출 $1억(약 1,400억) × 지분 31% × 순이익률 30% × PER 20배 ÷ 현재가치 할인 → 회사 숫자를 그대로 믿을 때 수백억~1천억대. 가정이 많아 Base에는 넣지 않음.</p>`)}
 ${card('국내 유전체 비교','11/24 Yahoo, 쓰리빌리언은 GVA가 메자닌 약 50억 보유',`<table class="vs"><thead><tr><th></th><th class="n">지씨지놈</th><th class="n">쓰리빌리언</th></tr></thead><tbody>
 <tr><td>시총</td><td class="n">${nf(MC)}억</td><td class="n">약 1,950억</td></tr><tr><td>PBR</td><td class="n">2.3배</td><td class="n">7.7배</td></tr><tr><td>PER</td><td class="n">약 30배(26E)</td><td class="n">131배</td></tr><tr><td>영업이익</td><td class="n">흑자(최근 4분기 ${nf(ttmOp)}억)</td><td class="n">미미</td></tr><tr><td>GVA 보유</td><td class="n">없음</td><td class="n">CB 25억 + 전환우선주 25억(전환가 12,501원)</td></tr></tbody></table>`)}
 </section>`;
 /* 주가 */
 H+=`<section class="page" id="px"><div class="page-head"><h1>주가</h1><p>상장(2025.6.11) 이후 일봉 · Yahoo</p></div>
 <div class="bar"><span class="lbl">기간</span><div class="seg" id="rng"><button data-r="60">3개월</button><button data-r="125">6개월</button><button data-r="0" class="on">상장 이후</button></div></div>
 ${card('지씨지놈 종가','고점 10,810원(상장 다음날) · 저점 4,310원(2026.7.30)',`<div class="ch-box tall"><canvas id="cP"></canvas></div>`)}
 ${card('상대 수익률 (상장일 = 100)','쓰리빌리언과 상관계수 0.39, 펌텍과 0.27. 펌텍이 3% 넘게 빠진 55일 동안 지씨지놈 평균 -1.6%',`<div class="ch-box"><canvas id="cR"></canvas></div>`)}
 </section>`;
 /* 피칭 */
 H+=`<section class="page" id="pitch"><div class="page-head"><h1>5분 피칭</h1><p>탑다운 → 바텀업 → 꿈의 결말 → GVA · 금액은 시총 기준 · 1분 약 300자</p></div>
 ${card('연결 멘트 (펌텍 → 지씨지놈, 20초)','',`<div class="script"><p>펌텍이 시장이 인정하기 시작한 성장을 합리적인 가격에 사는 아이디어라면, 두 번째는 국내에서 이미 돈을 버는 본업 가격에 미국이라는 꿈을 공짜로 얹는 아이디어입니다. 하나는 K뷰티 소비, 하나는 진단 의료라 상장 이후 상관계수는 0.27이고, 펌텍이 3% 넘게 빠진 날 두 번째 종목은 평균 1.6% 빠졌습니다. 두 번째는 지씨지놈입니다.</p></div>`)}
 ${card('스크립트','',`<div class="script">
 <p><span class="tg">[0:00 결론]</span>지씨지놈, 분할 매수 의견입니다. 지금 시총 1,830억 중 430억이 순현금이고, 국내 본업만 지금 배수로 계산해도 2,070억으로 240억이 남습니다. 미국 췌장암 검사는 0으로 넣었습니다. 대신 미국은 관문을 하나 넘을 때마다 시총이 붙는 구조입니다. 미국 검증 결과와 혁신의료기기 지정만 확인돼도 660~880억, 가던트 본계약까지 가면 1,200억이 더해집니다. 하방은 국내 성장이 꺾일 때 시총 1,300억, 지금보다 530억 아래입니다.</p>
 <p><span class="tg">[0:40 탑다운: 현실성 있는 꿈인가]</span>바이오는 꿈을 파는 곳이고, 중요한 건 그 꿈이 현실성 있느냐입니다. 미국에서 가던트는 대장암 혈액검사 쉴드로 올해 28만 건, 3천억원이 넘는 매출을 냅니다. 피로 암을 걸러 보험을 받고 돈을 버는 모델은 이미 증명됐습니다. 그런데 췌장암은 조기 발견이 생존을 가르는데도 표준 혈액 선별검사가 없습니다. 시장이 지금 만들어지는 단계입니다.</p>
 <p><span class="tg">[1:20 바텀업 1: 본업이 아래를 받칩니다]</span>지씨지놈은 녹십자 계열 유전체 검사 회사로 작년 흑자로 돌아섰습니다. 산전 검사 G-NIPT는 3분기 47%, 다중암 조기진단 아이캔서치는 2.5배 늘었고 영업이익률은 9.5%로 올라왔습니다. 3분기 매출이 1%만 는 건 일부 검사 재출시가 밀려 10억원이 4분기로 넘어갔기 때문입니다. 같은 검사가 일본에선 국내의 3~4배, 미국에선 5~6배 가격입니다.</p>
 <p><span class="tg">[2:10 바텀업 2: 꿈의 근거]</span>미국에 낼 췌장암 검사는 1·2기 민감도가 87.5%입니다. 가던트 자체 다중암 검사의 췌장암 민감도는 68% 수준이라, 가던트 입장에선 몇 년 들여 새로 만드는 것보다 지씨지놈 기술을 자기 판매망에 얹는 게 빠릅니다. 실제로 두 회사는 MOU를 맺고 유통 방식을 논의 중입니다. 회사 목표인 2030년 미국 1억 달러는 건당 1,500달러면 연 6.7만 건으로, 쉴드 물량의 4분의 1입니다.</p>
 <p><span class="tg">[3:00 결말: 시총 애드]</span>꿈이 이뤄지면 결말이 큽니다. 1억 달러 매출에 매출의 5배만 줘도 미국 사업가치는 7천억원입니다. 연말에 결정되는 미국 관계사 GC랩텍 연결 편입으로 절반 이상을 가져오면, 할인해도 지금 시총에 2,200억이 더해집니다. 췌장암 다음 간암·폐암까지 미국에 내면 1조원대 애드도 열립니다. 다만 단계별로 확인하며 사겠습니다. 첫 관문은 미국 1,500명 검증에서 특이도를 98%로 올려도 초기암 민감도가 90% 가까이 유지되느냐입니다.</p>
 <p><span class="tg">[3:50 GVA 관점과 리스크]</span>GVA는 같은 유전체 업종 쓰리빌리언을 전환사채로 담았습니다. 지씨지놈은 흑자와 순현금이 아래를 받치고 미국이 위를 여는, 주식으로 사는 메자닌 구조입니다. 리스크는 두 가지입니다. 연결 편입이 안 되면 미국 몫이 35%로 줄고, 특이도가 기준에 못 미치면 가던트 계약도 흔들립니다. 국내 검사 성장이 두 분기 연속 10% 아래로 내려가거나 미국 특이도가 95%에 머물면 비중을 줄이겠습니다. 하루 거래대금이 40억대라 30억은 일주일이면 담을 수 있습니다.</p></div>`)}
 ${card('외울 숫자 (말하는 순서대로)','',`<ul class="def"><li>시총 1,830억 · 순현금 430억 · Base 2,070억(+240억) · Bear 1,300억(-530억)</li><li>미국 애드: 데이터·BDD +660~880억 → 가던트 본계약 +1,210억 → 연결 편입 +2,200억 → 다중암 +1조원대</li><li>쉴드 28만 건 · $218~230M / 췌장암 표준 혈액검사 없음</li><li>G-NIPT +47% · 아이캔서치 2.5배 · OPM 9.5% · 재출시 지연 10억</li><li>PancSight 1·2기 87.5% vs 가던트 MCD 췌장 68% · $1억 = 6.7만 건 × $1,500</li><li>킬: 국내 성장 2분기 연속 10% 미만 · 미국 특이도 95% 정체 · 연결 편입 무산</li></ul>`)}
 </section>`;
 /* 질의 */
 const QA=[
 ['시총 애드를 어떻게 계산했나?','기준선은 국내 본업과 순현금입니다. 2027E 매출 410억에 지금 배수(EV/매출 4배)를 주고 순현금 430억을 더하면 시총 2,070억으로, 지금 1,830억보다 240억 위입니다. 미국은 2030년 매출 1억 달러 × 매출 5배 = 사업가치 7천억원을 연 15%로 할인하고(약 4천억), 지씨지놈 귀속 비율과 단계별 성공확률을 곱해 시총에 더했습니다.'],
 ['미국 매출이 지씨지놈에 얼마나 들어오나?','북미 권리는 2023년 관계사 GC랩텍에 독점 라이선스돼 있어, 지금 구조로는 로열티와 지분법(24.1% → 내년 31%)만 들어옵니다. 회사 목표대로 가도 로열티 8% 가정 시 연 67억이고, 이 경우 시총 애드는 +160~600억에 그칩니다. 그래서 연말 GC랩텍 연결 편입 결정이 가장 중요한 변수이고, 편입되면 귀속이 55% 수준으로 올라가 애드가 +2,200억이 됩니다.'],
 ['1~2조원 꿈은 근거가 있나?','가던트 쉴드는 대장암 혈액검사 하나로 올해 매출 2.2억 달러를 내고, 여기에 매출의 10~20배를 주면 3.1~6.3조원입니다. 췌장암 1억 달러에 매출 5배만 줘도 사업가치 7천억, 10배면 1.4조입니다. 다만 이 숫자는 미국 사업 100% 기준이라, 지씨지놈 시총에는 귀속 비율과 성공확률을 곱해 현재가치 +2,200~4,400억으로 봅니다.'],
 ['단계별 성공확률은 어떻게 정했나?','제 판단입니다. 지금 20%에서 미국 1,500명 결과가 좋으면 30%, BDD 지정 40%, 가던트 본계약 55%, LDT 출시·급여 75%, 매출 3천만 달러 90%로 올렸습니다. 관문마다 시총이 +440억에서 +1,980억까지 단계적으로 붙는다는 걸 보여주려는 틀이고, 각 관문의 확인 숫자를 같이 적어 두었습니다.'],
 ['FDA를 통과할 근거는?','BDD와 판매 허가를 나눠 봅니다. BDD는 생명을 위협하는 질환이고 승인된 췌장암 혈액 선별검사가 없어 요건이 맞습니다. 같은 방식의 Gene Solutions, Natera도 올해 지정받았습니다. 실제 판매 허가는 프리놈처럼 수만 명 전향 임상이 필요해 27년은 어렵다고 보고, 그래서 Base 시총에는 미국을 0으로 넣었습니다.'],
 ['미국 검증에서 성능이 떨어지면?','그레일은 전향적 연구에서 민감도가 최대 40% 떨어졌습니다. 첫 관문은 미국 1,500명 검증에서 특이도를 98%로 올려도 1·2기 민감도가 80% 후반~90%로 유지되느냐입니다. 지금 공개된 특이도는 95.4%입니다. 여기서 막히면 미국 애드는 0으로 돌아가지만, 시총 하방은 국내 본업과 순현금으로 봅니다.'],
 ['하방은 얼마인가?','국내 성장이 꺾여 EV/매출이 2.5배로 내려가면 2026E 매출 347억 기준 시총 1,300억, 지금보다 530억 아래입니다. 상장 이후 저점 부근이고, 이 중 430억이 순현금입니다.'],
 ['3분기 매출이 1%밖에 안 늘었는데?','리스크스크린·지놈헬스 재출시가 7월에서 9월로 밀려 약 10억이 4분기로 넘어갔습니다. 핵심 검사는 G-NIPT +47%, 아이캔서치 +147%로 늘었고 영업이익률은 9.5%로 올랐습니다.'],
 ['아이캔서치 건수가 2배인데 매출은 왜 덜 늘었나?','검진 매출에는 다른 검사도 있고, 5년 전 출시한 검사 업그레이드로 일부를 중단했습니다. 아이캔서치 상반기 매출은 약 13억이고, 없었다면 검진 매출이 20~30% 줄었을 거라고 회사가 설명했습니다.'],
 ['순이익이 영업이익보다 큰 이유는?','IPO 자금 400억을 아직 쓰지 않아 이자수익이 나고 금융손익이 개선됐습니다. 그래서 순이익 기준 PER보다 EV/매출로 시총을 봅니다.'],
 ['가던트가 왜 남의 췌장암 검사를 팔아주나?','가던트 자체 다중암 검사의 췌장암 민감도는 약 68%이고, 직접 경쟁사 ClearNote는 가던트와 미국에서 경쟁하는 회사라 기술을 넘길 이유가 없습니다. 지씨지놈은 미국 판매망이 없고 국내에서 Guardant360을 팔아 온 관계가 있습니다. 다만 아직 MOU 단계라, 본계약이 나오면 시총 애드가 +880억에서 +1,210억으로 한 단계 올라간다고 봅니다.'],
 ['왜 쓰리빌리언이 아니라 지씨지놈인가?','시총은 둘 다 약 1,900억인데, 지씨지놈은 매출이 3~4배이고 흑자입니다. PBR은 2.3배 vs 7.7배입니다. GVA가 쓰리빌리언을 메자닌으로 담은 걸 보면, 주식으로 담을 수 있는 쪽은 지씨지놈이라고 봤습니다.'],
 ['녹십자의료재단 의존도는?','1H26 매출의 83.6%가 녹십자의료재단입니다. 재단이 병·의원 검체를 받아 지씨지놈이 분석하는 계약(2019~) 구조라 영업망은 강점이지만, 계약 조건이 바뀌면 바로 실적에 영향이 갑니다.'],
 ['수급 이슈는?','녹십자 19.6%, 특수관계인 22.9%, 유통 57.5%이고 보호예수는 전량 해제됐습니다. 회사는 더 이상 수급 이슈가 없다고 했습니다.'],
 ['펌텍과 같이 들어도 되나?','상장 이후 상관계수 0.27입니다. 펌텍이 3% 넘게 빠진 55일 동안 지씨지놈은 평균 -1.6%였습니다. 하루 거래대금이 40억대라 30억 비중은 일주일이면 담을 수 있습니다.']];
 H+=`<section class="page" id="qa"><div class="page-head"><h1>예상 질의</h1><p>눌러서 답 보기</p></div>${card('','',`<div class="qa">${QA.map(([q,a])=>`<details><summary>${q}</summary><p>${a}</p></details>`).join('')}</div>`)}</section>`;
 H+=`<section class="page" id="src"><div class="page-head"><h1>출처와 확인할 것</h1></div>${card('출처','',`<ul class="def"><li>지씨지놈 컨콜 메모(2026.11.6, 노션)</li><li>키움증권 「지놈 아저씨 미국 간대요」(2026.11.20, Not Rated)</li><li>삼성증권 「내실을 다지면서 미국 진출 순항 중」(2026.11.2, Not Rated)</li><li>주가: Yahoo Finance(11/24 종가 ${nf(PX)}원). 네이버 표시가와 다를 수 있음</li><li>GVA 쓰리빌리언 보유: DART 전환사채·유상증자 결정(2026.4.23)</li></ul>`)}
 ${card('면접 전 확인','',`<ul class="def"><li>3Q26 순이익과 분기보고서 확정 숫자(DART 접속 제한으로 미확인)</li><li>11/24 종가: Yahoo 7,740원 vs 네이버 장중 7,690원</li><li>GC랩텍 로열티율과 연결 편입 결정</li><li>순현금 430억은 회사 설명 기준(삼성: 1H26 현금성 자산 420억)</li></ul>`)}</section>`;
 $('#main').innerHTML=H;
 $('#foot').textContent='리서치 정리 · 투자 권유 아님 · 이미지 출처: 지씨지놈 IR';
 $('#stamp').textContent='기준 2026-11-24';
 ['vR','vM','vC','vU'].forEach(id=>document.getElementById(id).addEventListener('input',calc));calc();['rU','rS','rR','rM','rE','rP'].forEach(id=>document.getElementById(id).addEventListener('input',rcalc));rcalc();
 document.querySelectorAll('#rng button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#rng button').forEach(x=>x.classList.toggle('on',x===b));drawPx(+b.dataset.r)});
}

function rcalc(){const g=k=>+document.getElementById(k).value;const usd=g('rU'),sh=g('rS')/100,r=g('rR')/100,m=g('rM')/100,e=g('rE')/100,p=g('rP')/100;
 const gross=usd*14,lab=gross*sh,roy=lab*r,eq=lab*m*e,val=(roy+eq)*20/1.75*p,ps=val/SH*1e4;
 document.getElementById('rOut').innerHTML=`<table class="vs"><tbody><tr><td>미국 검사 매출</td><td>${nf(gross)}억</td></tr><tr><td>랩텍 매출</td><td>${nf(lab)}억</td></tr><tr><td>지씨지놈 로열티 = 매출·영업이익</td><td><b>${nf(roy)}억</b> (2026E 영업이익 28억의 ${nf(roy/28,1)}배)</td></tr><tr><td>지분법이익(영업외)</td><td>${nf(eq)}억</td></tr><tr><td>미국 시총 애드(현재가치)</td><td><b>+${nf(val)}억</b> (지금 시총 ${nf(MC)}억의 ${nf(val/MC*100)}%)</td></tr></tbody></table>`}
function calc(){const r=+$('#vR').value,m=+$('#vM').value,c=+$('#vC').value,u=+$('#vU').value;const v=r*m+c+u;$('#vOut').textContent=nf(v)+'억';const add=v-MC;$('#vUp').innerHTML=`지금 대비 <span class="${cls(add)}">${add>0?'+':''}${nf(add)}억 (${pc(add/MC*100)})</span>`}

/* ---------- 차트 ---------- */
function mk(id,cfg){const el=document.getElementById(id);if(!el)return;const old=Chart.getChart(el);if(old)old.destroy();Chart.defaults.color=css('--sub');Chart.defaults.borderColor=css('--grid');Chart.defaults.font.family='Pretendard Variable, Pretendard, sans-serif';new Chart(el,cfg)}
function draw(h){
 const c1=css('--c1'),c2=css('--c2'),c3=css('--c3'),c4=css('--c4'),c5=css('--c5');
 const O={responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:10}}}};
 if(h==='fin'){
  mk('cQ',{data:{labels:Q.map(r=>r.q),datasets:[{type:'bar',label:'매출(억)',data:Q.map(r=>r.rev),backgroundColor:c1,yAxisID:'y'},{type:'bar',label:'영업이익(억)',data:Q.map(r=>r.op),backgroundColor:c2,yAxisID:'y'},{type:'line',label:'OPM(%)',data:Q.map(r=>+(r.op/r.rev*100).toFixed(1)),borderColor:c5,yAxisID:'y1',tension:.3}]},options:{...O,scales:{y:{beginAtZero:true},y1:{position:'right',grid:{display:false},ticks:{callback:v=>v+'%'}}}}});
  mk('cY',{data:{labels:Y.map(r=>r.y),datasets:[{type:'bar',label:'매출(억)',data:Y.map(r=>r.rev),backgroundColor:Y.map(r=>r.e?c1+'88':c1)},{type:'line',label:'영업이익(억)',data:Y.map(r=>r.op),borderColor:c2,yAxisID:'y1'}]},options:{...O,scales:{y:{beginAtZero:true},y1:{position:'right',grid:{display:false}}}}});
  mk('cS',{type:'bar',data:{labels:SEG.q,datasets:[['산과',c1],['암검사',c2],['유전희귀',c3],['검진',c4]].map(([k,c])=>({label:k,data:SEG[k],backgroundColor:c}))},options:{...O,scales:{x:{stacked:true},y:{stacked:true}}}});
 }
 if(h==='kpi'){
  mk('cN',{type:'bar',data:{labels:NIPT.y,datasets:[{label:'건',data:NIPT.v,backgroundColor:NIPT.y.map(y=>y.includes('Q')||y.includes('H')?c3:c1)}]},options:{...O,plugins:{legend:{display:false}}}});
  mk('cI',{type:'bar',data:{labels:ICS.y,datasets:[{label:'건',data:ICS.v,backgroundColor:ICS.y.map(y=>y.includes('Q')||y.includes('H')?c3:c2)}]},options:{...O,plugins:{legend:{display:false}}}});
 }

 if(h==='tech'){
  const xs=[];for(let i=80;i<=260;i+=4)xs.push(i);
  const g=(x,m,s)=>Math.exp(-((x-m)**2)/(2*s*s));
  mk('cFrag',{type:'line',data:{labels:xs,datasets:[{label:'정상 cfDNA',data:xs.map(x=>+(g(x,167,14)+0.15*g(x,333/2+0,40)).toFixed(3)),borderColor:c1,pointRadius:0,tension:.4},{label:'암 유래 cfDNA',data:xs.map(x=>+(0.75*g(x,145,18)+0.1*g(x,167,14)).toFixed(3)),borderColor:c5,pointRadius:0,tension:.4,borderDash:[5,4]}]},options:{...O,scales:{x:{title:{display:true,text:'조각 길이(bp)'},ticks:{maxTicksLimit:8}},y:{title:{display:true,text:'비율(개념)'},ticks:{display:false}}}}});
  const ppv=(se,sp,pv)=>se*pv/(se*pv+(1-sp)*(1-pv))*100;
  mk('cPPV',{type:'bar',data:{labels:['아이캔서치','PancSight(췌장)','Shield(가던트)','Galleri(Grail)'],datasets:[{label:'민감도(%)',data:[84.5,87.5,83,37.5],backgroundColor:c1},{label:'특이도(%)',data:[94.5,95.4,90,99.85],backgroundColor:c3},{label:'PPV @0.8%(%)',data:[ppv(.845,.945,.008),ppv(.875,.954,.008),ppv(.83,.90,.008),ppv(.375,.9985,.008)].map(v=>+v.toFixed(1)),backgroundColor:c2}]},options:{...O,scales:{y:{max:100}}}});
 }
 if(h==='peer'){
  const fx=1400;const pr=PEERS.map(p=>({n:p.n,ps:+p.ps.toFixed(1),opm:+(p.opm*100).toFixed(0)}));
  const col=pr.map(p=>p.n==='지씨지놈'?css('--up'):c1);
  mk('cPS',{type:'bar',data:{labels:pr.map(p=>p.n),datasets:[{data:pr.map(p=>p.ps),backgroundColor:col}]},options:{...O,indexAxis:'y',plugins:{legend:{display:false}}}});
  mk('cOPM',{type:'bar',data:{labels:pr.map(p=>p.n),datasets:[{data:pr.map(p=>Math.max(p.opm,-120)),backgroundColor:col}]},options:{...O,indexAxis:'y',plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>pr[c.dataIndex].opm+'%'}}},scales:{x:{ticks:{callback:v=>v+'%'}}}}});
 }

 if(h==='dream'){
  const st=['지금','미국 데이터','BDD','가던트 계약','LDT·급여','매출 $30M'],a5=[440,660,880,1210,1650,1980],a10=[880,1320,1760,2420,3300,3960];
  mk('cDream',{type:'bar',data:{labels:st,datasets:[{label:'지금 시총',data:st.map(()=>Math.round(MC)),backgroundColor:css('--c6'),stack:'s'},{label:'미국 애드(5배)',data:a5,backgroundColor:c1,stack:'s'},{label:'추가(10배일 때)',data:a10.map((v,i)=>v-a5[i]),backgroundColor:c2+'99',stack:'s'}]},options:{...O,scales:{x:{stacked:true},y:{stacked:true,ticks:{callback:v=>nf(v)+'억'}}},plugins:{legend:{position:'bottom'},tooltip:{callbacks:{label:c=>c.dataset.label+': '+nf(c.raw)+'억'}}}}});
 }
 if(h==='us') mk('cJ',{type:'bar',data:{labels:JP.q,datasets:[{label:'억원',data:JP.v,backgroundColor:JP.q.map(q=>q.includes('E')?c2+'99':c2)}]},options:{...O,plugins:{legend:{display:false}}}});
 if(h==='val') mk('cV',{type:'bar',data:{labels:['Bear','현재가','Base','Bull'],datasets:[{data:[5500,PX,8800,12200],backgroundColor:[css('--down'),c6(),c1,css('--up')]}]},options:{...O,indexAxis:'y',plugins:{legend:{display:false}}}});
 if(h==='px') drawPx(0);
}
function c6(){return css('--c6')}
function drawPx(n){
 if(!P)return;const L=P.d.length,s=n?L-n:0;
 const lab=P.d.slice(s),gc=P.gc.slice(s);
 mk('cP',{type:'line',data:{labels:lab,datasets:[{label:'지씨지놈',data:gc,borderColor:css('--c1'),pointRadius:0,borderWidth:1.6,spanGaps:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{maxTicksLimit:8}}}}});
 const base=(a)=>{const f=a.find(x=>x!=null);return a.map(x=>x==null?null:+(x/f*100).toFixed(1))};
 mk('cR',{type:'line',data:{labels:P.d,datasets:[['지씨지놈',P.gc,'--c1'],['쓰리빌리언',P.tb,'--c4'],['펌텍코리아',P.pt,'--c2']].map(([n,a,c])=>({label:n,data:base(a),borderColor:css(c),pointRadius:0,borderWidth:1.4,spanGaps:true}))},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:10}}},scales:{x:{ticks:{maxTicksLimit:8}}}}});
}
$('#theme').onclick=()=>{const r=document.documentElement;const cur=r.dataset.theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');r.dataset.theme=cur==='dark'?'light':'dark';nav()};
build();window.addEventListener('hashchange',nav);nav();
</script>
</body>
</html>
