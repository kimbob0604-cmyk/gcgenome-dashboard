<style>
.pill{display:inline-block;font-size:11.5px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--chip);margin:0 4px 4px 0}
.pill.ok{background:rgba(20,163,154,.14);color:var(--c3)}.pill.wait{background:rgba(245,158,11,.16);color:#b7791f}.pill.risk{background:rgba(214,69,61,.12);color:var(--up)}
.tl{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.tl .st{border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:var(--card)}
.tl .st .w{font-size:12px;color:var(--muted)}.tl .st .e{font-weight:700;margin:2px 0}.tl .st .x{font-size:12px;color:var(--sub)}
.script p{margin:0 0 10px;line-height:1.7}.script .tg{font-weight:800;color:var(--accent);margin-right:6px}
.qa details{border-top:1px solid var(--line);padding:10px 2px}.qa details:first-child{border-top:0}
.qa summary{cursor:pointer;font-weight:700}.qa details p{margin:8px 0 0;color:var(--sub);line-height:1.65}
.fig{width:100%;border-radius:12px;border:1px solid var(--line);background:#fff;display:block}.figcap{font-size:12px;color:var(--muted);margin:6px 0 0}.flow{display:flex;flex-wrap:wrap;gap:8px;align-items:stretch}.flow .b{flex:1 1 140px;border:1px solid var(--line);border-radius:12px;padding:10px;background:var(--hover)}.flow .b b{display:block;margin-bottom:2px}.flow .b span{font-size:12px;color:var(--sub)}.flow .ar{align-self:center;color:var(--muted)}
.big{font-size:30px;font-weight:800;letter-spacing:-.03em}
.vs td{white-space:normal;vertical-align:top}.vs td:first-child{font-weight:600;white-space:nowrap}
td{white-space:normal}
</style>
</head>
<body>
<header class="top">
  <div class="brand">지씨지놈 대시보드</div>
  <nav class="tabs" id="tabs"></nav>
  <div class="top-right"><span id="stamp"></span><button id="theme" class="icon-btn" aria-label="다크 모드 전환" title="다크 모드 전환">◐</button></div>
</header>
<main id="main"></main>
<footer id="foot"></footer>
<script>
const P=/*__PX__*/null;
const $=s=>document.querySelector(s);
const nf=(x,d=0)=>x==null?'-':Number(x).toLocaleString('ko-KR',{maximumFractionDigits:d,minimumFractionDigits:d});
const pc=(x,d=0)=>x==null?'-':(x>0?'+':'')+nf(x,d)+'%';
const cls=x=>x>0?'up':x<0?'down':'';
const css=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim();

/* ---------- 데이터 (억원) ---------- */
const PX=7740, SH=2365.08, NETCASH=430;           // 11/24 종가(Yahoo), 주식수(만주), 순현금(컨콜)
const MC=PX*SH/1e4;                                // 억원
const Q=[ // 분기 실적: 삼성증권 1Q25~2Q26, 키움 3Q26
 {q:'1Q25',rev:68,op:-0.3,ni:3},{q:'2Q25',rev:78,op:2.9,ni:-1},{q:'3Q25',rev:88,op:7.7,ni:14},{q:'4Q25',rev:81,op:2.0,ni:24},
 {q:'1Q26',rev:74,op:1.4,ni:8},{q:'2Q26',rev:83,op:4.3,ni:8},{q:'3Q26',rev:89,op:8.5,ni:null}];
const SEG={q:['1Q25','2Q25','3Q25','4Q25','1Q26','2Q26'],
 산과:[19,21,23,22,22,22],암검사:[26,30,32,29,30,30],유전희귀:[14,11,15,14,14,16],검진:[8,16,18,16,9,15]};
const Y=[{y:'2023',rev:273,op:2},{y:'2024',rev:259,op:-12},{y:'2025',rev:315,op:12},{y:'2026E',rev:347,op:28,e:1},{y:'2027E',rev:410,op:41,e:1}];
const NIPT={y:['2023','2024','2025','1H26','3Q26'],v:[14000,18000,25200,14000,11300]};
const ICS={y:['2024','2025','1H26','3Q26'],v:[900,5100,4100,4200]};
const JP={q:['1Q26','2Q26','3Q26','4Q26E','2027E(회사)'],v:[0,5,7,10,100]};

const PEERS=[{"t": "GRAL", "n": "Grail", "cur": "USD", "px": 103.55, "mc": 4655833088, "rev": 166604000, "rg": 0.037, "opm": -3.32038, "gm": 0.46679002, "ps": 27.945505, "ni": -406177984, "y52": -0.10906643, "name": "GRAIL, Inc."}, {"t": "GH", "n": "Guardant Health", "cur": "USD", "px": 154.17, "mc": 20857036800, "rev": 1278883968, "rg": 0.361, "opm": -0.39403, "gm": 0.65190005, "ps": 16.308779, "ni": -485072992, "y52": 0.31083143, "name": "Guardant Health, Inc."}, {"t": "NTRA", "n": "Natera", "cur": "USD", "px": 292.39, "mc": 42397876224, "rev": 2908875008, "rg": 0.341, "opm": -0.085360005, "gm": 0.65142995, "ps": 14.575352, "ni": -164714000, "y52": 0.14594686, "name": "Natera, Inc."}, {"t": "394800.KQ", "n": "쓰리빌리언", "cur": "KRW", "px": 6140.0, "mc": 195390472192, "rev": 9783881728, "rg": 1.025, "opm": -0.71685, "gm": 1.0, "ps": 19.97065, "ni": -5966963712, "y52": -0.45327103, "name": "3billion, Inc."}, {"t": "228760.KQ", "n": "지노믹트리", "cur": "KRW", "px": 8070.0, "mc": 198078119936, "rev": 2946381056, "rg": -0.511, "opm": -3.9839802, "gm": -0.0558, "ps": 67.2276, "ni": -9026676736, "y52": -0.6745417, "name": "Genomictree Inc."}, {"t": "461030.KQ", "n": "아이엠비디엑스", "cur": "KRW", "px": 2120.0, "mc": 30389176320, "rev": 5599463424, "rg": -0.0, "opm": -1.5375, "gm": 0.28047, "ps": 5.427159, "ni": -7588599808, "y52": -0.77558637, "name": "IMB Dx, Inc."}, {"t": "340450.KQ", "n": "지씨지놈", "cur": "KRW", "px": 7740.0, "mc": 183057137664, "rev": 32637421568, "rg": 0.062, "opm": 0.04737, "gm": 0.46627998, "ps": 5.6088114, "ni": 5415054848, "y52": 0.1942215, "name": "GC Genome Corporation"}];
/* ---------- 탭 ---------- */
const PAGES=[['sum','요약'],['fin','실적'],['kpi','성장 지표'],['tech','기술 이해'],['peer','글로벌 비교'],['us','미국·일본'],['reg','허가·로열티'],['dream','꿈의 지도'],['val','밸류'],['px','주가'],['pitch','5분 피칭'],['qa','예상 질의'],['src','출처']];
let charts=[];
function nav(){const h=(location.hash||'#sum').slice(1);document.querySelectorAll('.page').forEach(p=>p.classList.toggle('on',p.id===h));document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('on',t.dataset.p===h));window.scrollTo(0,0);draw(h)}
function card(h,cap,body){return `<div class="card"><h2>${h}</h2>${cap?`<p class="cap">${cap}</p>`:''}${body}</div>`}
function kpi(l,v,s,go){return `<button class="kpi" onclick="location.hash='${go}'"><div class="l">${l}</div><div class="v">${v}</div><div class="s">${s}</div></button>`}

function build(){
 $('#tabs').innerHTML=PAGES.map(([k,n])=>`<a class="tab" data-p="${k}" href="#${k}">${n}</a>`).join('');
 const ttmRev=Q.slice(-4).reduce((a,b)=>a+b.rev,0), ttmOp=Q.slice(-4).reduce((a,b)=>a+b.op,0);
 const ev=MC-NETCASH;
 let H='';
 /* 요약 */
 H+=`<section class="page" id="sum"><div class="page-head"><h1>지씨지놈 (340450) · 분할 매수</h1><p>국내 흑자 본업 가격에 미국 췌장암 검사 옵션을 0으로 얹은 종목 · 11/24 종가 ${nf(PX)}원(Yahoo)</p></div>
 <div class="kpis">
 ${kpi('시가총액',nf(MC)+'억',`순현금 ${NETCASH}억 = 시총의 ${nf(NETCASH/MC*100)}%`,'val')}
 ${kpi('EV / 2026E 매출',nf(ev/347,1)+'배',`삼성 기준 글로벌 피어 20~35배`,'val')}
 ${kpi('최근 4분기 매출',nf(ttmRev)+'억',`영업이익 ${nf(ttmOp)}억 · 3Q26 OPM 9.5%`,'fin')}
 ${kpi('G-NIPT 3Q26',nf(11300)+'건','YoY +46.8% · QoQ +61.4%','kpi')}
 ${kpi('아이캔서치 3Q26',nf(4200)+'건','YoY +147% · QoQ +133%','kpi')}
 ${kpi('PancSight 1/2기 민감도','87.5%','특이도 95.4% · 가던트 쉴드 1기 58%','us')}
 </div>
 <div class="two">
 ${card('한 장 요약','',`<table class="vs"><tbody>
 <tr><td>의견</td><td>분할 매수 · Base 시총 2,070억(+240억) · Bull 2,890억(+1,060억) · Bear 1,300억(-530억) · 미국 꿈 +2,200억~1조원대</td></tr>
 <tr><td>싼 이유</td><td>EV/매출 ${nf(ev/347,1)}배(2026E) vs 가던트·나테라·그레일 20~35배. 미국 매출 0원 가정에서도 국내 본업이 흑자</td></tr>
 <tr><td>본업</td><td>2025 흑자전환(매출 315억·영업이익 12억) → 2026E 347억·28억(키움), 회사는 370억·하이싱글 OPM</td></tr>
 <tr><td>현금</td><td>순현금 약 430억(IPO 400억 미사용) → 이자수익으로 순이익 > 영업이익</td></tr>
 <tr><td>옵션</td><td>일본: 아이캔서치 2Q 5억 → 3Q 7억 → 4Q 10억 / G-NIPT 1월 인가 신청<br>미국: PancSight BDD 1Q27 → FDA 27년 중순 → 보험 2H27 → 매출 1H28</td></tr>
 <tr><td>수급·지배구조</td><td>녹십자 외 42.6%, 보호예수 전량 해제(반기보고서 기준), 유통 57.5%</td></tr>
 <tr><td>유동성</td><td>20일 평균 거래대금 44억, 연 변동성 65%, 펌텍과 상관계수 0.27</td></tr>
 </tbody></table>`)}
 ${card('촉매 타임라인','회사 컨콜(11/6)·키움(11/20)·삼성(11/2) 기준. 회사 계획이라 지연 가능',`<div class="tl">
 <div class="st"><div class="w">4Q26</div><div class="e">재출시 지연분 10억 인식</div><div class="x">리스크스크린·지놈헬스</div></div>
 <div class="st"><div class="w">12월~1Q27</div><div class="e">FDA BDD 신청</div><div class="x">혁신의료기기, 60일 내 결정</div><span class="pill wait">대기</span></div>
 <div class="st"><div class="w">2027.1~3</div><div class="e">G-NIPT 일본 인가</div><div class="x">2Q27부터 매출</div><span class="pill wait">대기</span></div>
 <div class="st"><div class="w">연말</div><div class="e">GC랩텍 연결 편입 결정</div><div class="x">녹십자홀딩스 지분 일부 인수 논의</div></div>
 <div class="st"><div class="w">27년 중순</div><div class="e">FDA 허가·가던트 계약</div><div class="x">7~8월 본계약 예상(회사). "허가"는 BDD 지정일 가능성, 판매 허가는 전향 임상 필요</div><span class="pill risk">확인 필요</span></div>
 <div class="st"><div class="w">1H28</div><div class="e">미국 매출 개시</div><div class="x">2028 $30M → 2030 $100M(회사 목표)</div></div>
 </div>`)}
 </div></section>`;
 /* 실적 */
 H+=`<section class="page" id="fin"><div class="page-head"><h1>실적</h1><p>억원, 연결. 1Q25~2Q26 삼성증권(Quantiwise), 3Q26 키움(11/20). 3Q26 순이익은 미확인</p></div>
 <div class="two">${card('분기 매출과 영업이익률','',`<div class="ch-box"><canvas id="cQ"></canvas></div>`)}
 ${card('연간 매출·영업이익','2026E 키움, 2027E 내 추정(매출 +18%, OPM 10%)',`<div class="ch-box"><canvas id="cY"></canvas></div>`)}</div>
 ${card('외울 숫자','YoY는 같은 분기 비교',`<div class="tw"><table><thead><tr><th>분기</th><th class="n">매출</th><th class="n">YoY</th><th class="n">영업이익</th><th class="n">OPM</th><th class="n">순이익</th></tr></thead><tbody>${Q.map((r,i)=>{const p=i>=4?Q[i-4]:null;const y=p?(r.rev/p.rev-1)*100:null;return `<tr><td>${r.q}</td><td class="n">${nf(r.rev)}</td><td class="n ${cls(y)}">${pc(y)}</td><td class="n">${nf(r.op,1)}</td><td class="n">${nf(r.op/r.rev*100,1)}%</td><td class="n">${r.ni==null?'미확인':nf(r.ni)}</td></tr>`}).join('')}
 <tr><td><b>2025</b></td><td class="n"><b>315</b></td><td class="n up">+22%</td><td class="n"><b>12</b></td><td class="n">3.8%</td><td class="n"><b>40</b></td></tr>
 <tr><td><b>최근 4분기</b></td><td class="n"><b>${nf(ttmRev)}</b></td><td></td><td class="n"><b>${nf(ttmOp)}</b></td><td class="n">${nf(ttmOp/ttmRev*100,1)}%</td><td></td></tr></tbody></table></div>
 <div class="note" style="margin-top:10px">3Q26 매출 +1.2% YoY에 그친 건 리스크스크린·지놈헬스 재출시가 7월→9월로 밀려 약 10억이 4Q26로 넘어갔기 때문(키움). 하반기 검진 성수기 계절성이 있어 4Q가 가장 큼.</div>`)}
 ${card('사업부 매출 (억원)','1H26 비중: 암검사 38% · 산과 28% · 유전희귀 19% · 검진 15% / 내수 98%',`<div class="ch-box"><canvas id="cS"></canvas></div>`)}
 </section>`;
 /* 성장 지표 */
 H+=`<section class="page" id="kpi"><div class="page-head"><h1>성장 지표</h1><p>검사 건수와 거래처 · 회사·키움·삼성</p></div>
 <div class="two">${card('G-NIPT(산전 선별) 검사 건수','2026 목표 3만 건(+20%). 3Q26 11,300건 YoY +46.8%',`<div class="ch-box"><canvas id="cN"></canvas></div>`)}
 ${card('아이캔서치(다중암 조기진단) 검사 건수','2024 출시 → 2025 5배. 3Q26 4,200건 YoY +147%',`<div class="ch-box"><canvas id="cI"></canvas></div>`)}</div>
 <div class="two">${card('아이캔서치 거래처','',`<ul class="def"><li>국내 기업 거래처 120개(1H26) → 연내 160~170개 목표</li><li>상급종합병원 보급률 100%, 일반 종합병원 40%(삼성)</li><li>삼성그룹 임직원 검진(약 7만 명, 가족 포함 23만 명) → LG·대한항공·기아·한수원 추가(1H26)</li><li>일본 거래처 33개(도쿄 캔서클리닉, 쇼와의대 등)</li><li>국내 암 스크리닝 점유율 사실상 100%(회사 주장)</li></ul>`)}
 ${card('판가 사다리','같은 검사가 해외로 가면 단가가 몇 배가 되는지',`<table><thead><tr><th>검사</th><th class="n">한국</th><th class="n">일본</th><th class="n">미국</th></tr></thead><tbody>
 <tr><td>G-NIPT</td><td class="n">35만원</td><td class="n">120~160만원</td><td class="n">240~320만원</td></tr>
 <tr><td>아이캔서치 / PancSight</td><td class="n">30~40만원</td><td class="n">3~4배</td><td class="n">$1,000~1,200(5~6배)</td></tr></tbody></table>
 <p class="cap" style="margin-top:8px">회사는 국내 OPM 20%, 미국 40~50% 가능하다고 설명(컨콜). 미국은 가던트와 매출 배분(가던트 4 : 랩텍 6) 논의 중으로 미확정.</p>`)}</div>
 </section>`;

 /* 기술 */
 H+=`<section class="page" id="tech"><div class="page-head"><h1>기술 이해</h1><p>피 한 번 뽑아 암 신호를 찾는 방식 · 회사 IR 자료와 개념도</p></div>
 ${card('검사가 돌아가는 순서','아이캔서치(다중암)와 PancSight(췌장암)는 같은 원리',`<div class="flow">
 <div class="b"><b>① 채혈 10mL</b><span>건강검진 때 함께. 경쟁사는 20~40mL</span></div><div class="ar">→</div>
 <div class="b"><b>② cfDNA 추출</b><span>죽은 세포가 혈액에 흘린 DNA 조각. 암이 있으면 암세포 조각이 섞임</span></div><div class="ar">→</div>
 <div class="b"><b>③ 저밀도 전장유전체 시퀀싱</b><span>샘플당 10Gb만 읽어 1회 200건 처리(메틸화 방식 100Gb·20건)</span></div><div class="ar">→</div>
 <div class="b"><b>④ AI 판독</b><span>조각 길이·끝부분 서열·뉴클레오솜 위치·구간별 복제수 변화를 함께 학습</span></div><div class="ar">→</div>
 <div class="b"><b>⑤ 결과 7일</b><span>10종 암 신호 여부와 의심 부위</span></div></div>`)}
 <div class="two">${card('왜 조각 길이를 보나 (개념도)','정상 cfDNA는 뉴클레오솜 1개 길이(약 167bp)에서 봉우리, 암 유래 조각은 더 짧은 쪽으로 치우침. 실제 데이터가 아닌 개념도 · 근거: Bae et al., Nat Commun 2023(KAIST·지씨지놈)',`<div class="ch-box"><canvas id="cFrag"></canvas></div>`)}
 ${card('메틸화 방식과 무엇이 다른가','회사 설명(컨콜 11/6)과 키움 비교표',`<table class="vs"><thead><tr><th></th><th>지씨지놈 (조각 패턴)</th><th>Grail·가던트 등 (메틸화)</th></tr></thead><tbody>
 <tr><td>읽는 것</td><td>DNA 조각의 길이·모양·끝 서열 + 복제수</td><td>암에서 바뀐 DNA 메틸화 표지</td></tr>
 <tr><td>조기암</td><td>초기에도 조각 신호가 나온다는 주장. 췌장암 1기 민감도 87.5%(10월 컷오프)</td><td>암이 어느 정도 자라야 메틸화 신호가 뚜렷. 가던트 1기 58%(회사 비교)</td></tr>
 <tr><td>비용·처리량</td><td>샘플당 10Gb, 1회 200건</td><td>100Gb·20건(전장), 12Gb·188건(표적)</td></tr>
 <tr><td>약점</td><td>특이도 94.5%로 낮은 편 → 양성 중 실제 암 비율이 낮음</td><td>특이도 99%대, 대신 민감도 낮음(Galleri 전향 35~40%)</td></tr></tbody></table>`)}</div>
 ${card('민감도·특이도·PPV 한 번에 읽기','검진 인구의 연간 암 유병률을 0.8%로 두었을 때 · PPV = 양성 판정 중 실제 암 비율',`<div class="two"><div class="ch-box"><canvas id="cPPV"></canvas></div><div><ul class="def"><li><b>아이캔서치</b> 민감도 84.5% · 특이도 94.5% → PPV 약 <b>11%</b>. 많이 잡고 많이 틀리는 설계</li><li><b>Galleri</b> 민감도 35~40%(전향) · 특이도 99.85% → PPV 약 <b>65%</b>. 적게 잡고 거의 안 틀림</li><li>한국은 추가 영상검사가 싸서 민감도 중심 설계가 맞지만, 미국 승인·보험에서는 특이도가 핵심 쟁점</li><li>그래서 미국은 다중암이 아니라 대체 검사가 없는 <b>췌장암 단일암</b>(특이도 95.4%)으로 먼저 감</li><li>연구 설계가 달라(사례-대조 vs 전향) 직접 비교가 아닌 구조 비교</li></ul></div></div>`)}
 <div class="two">${card('제품 포트폴리오','자료: 지씨지놈 IR',`<img class="fig" src="img/ir_portfolio.jpg" alt="지씨지놈 제품 포트폴리오: 산과·암·유전희귀·검진 검사"><p class="figcap">핵심기술 두 개: G-NIPT(산전), 아이캔서치(다중암)</p>`)}
 ${card('아이캔서치 vs 경쟁 검사','자료: 지씨지놈 IR 2026(컨콜 자료)',`<img class="fig" src="img/ir_mced.jpg" alt="아이캔서치와 I사, G사 비교표"><p class="figcap">I사는 국내 메틸화 경쟁사, G사는 가던트 쉴드(대장암 1종). 임상 검체 11,387명은 암환자:건강인 1:3 사례-대조</p>`)}</div>
 <div class="two">${card('돈 버는 구조 ① 검사 서비스','자료: 지씨지놈 IR',`<img class="fig" src="img/ir_service.jpg" alt="직접·간접 검사 서비스 모델"><p class="figcap">간접 모델의 파트너가 녹십자의료재단 → 1H26 매출의 83.6%가 특수관계자(재단)</p>`)}
 ${card('돈 버는 구조 ② 해외 기술 수출','자료: 지씨지놈 IR',`<img class="fig" src="img/ir_licensing.jpg" alt="해외 Lab 마일스톤·로열티 모델"><p class="figcap">미국은 GC랩텍에 2023.4 독점 라이선스($10.3M, 누적 수취 6.7억). 상업화·보험·FDA 단계별 기술료 → 매출 대비 로열티</p>`)}</div>
 </section>`;
 /* 글로벌 비교 */
 const fx=1400;
 const pr=PEERS.map(p=>({...p,mcK:p.cur==='USD'?p.mc*fx/1e8:p.mc/1e8,revK:p.cur==='USD'?p.rev*fx/1e8:p.rev/1e8}));
 H+=`<section class="page" id="peer"><div class="page-head"><h1>글로벌 비교</h1><p>Yahoo Finance 11/24 · 달러는 1,400원 환산 · 매출·이익은 최근 4분기</p></div>
 ${card('밸류와 수익성','지씨지놈만 흑자, P/S는 가장 낮은 편',`<div class="tw"><table><thead><tr><th>회사</th><th>주력</th><th class="n">시총(억원)</th><th class="n">매출(억원)</th><th class="n">매출 성장</th><th class="n">영업이익률</th><th class="n">P/S</th><th class="n">1년 주가</th></tr></thead><tbody>${pr.map(p=>{const biz={GRAL:'다중암 조기검출 Galleri',GH:'대장암 혈액검사 Shield, 암 정밀',NTRA:'NIPT·MRD(재발 모니터링)','394800.KQ':'AI 희귀질환 유전체 해석','228760.KQ':'메틸화 암 조기진단','461030.KQ':'액체생검 다중암(국내)','340450.KQ':'NIPT·다중암·암 정밀'}[p.t];return `<tr${p.t==='340450.KQ'?' style="font-weight:700"':''}><td>${p.n}</td><td class="d">${biz}</td><td class="n">${nf(p.mcK)}</td><td class="n">${nf(p.revK)}</td><td class="n ${cls(p.rg)}">${pc(p.rg*100)}</td><td class="n ${cls(p.opm)}">${pc(p.opm*100)}</td><td class="n">${nf(p.ps,1)}배</td><td class="n ${cls(p.y52)}">${pc(p.y52*100)}</td></tr>`}).join('')}</tbody></table></div>`)}
 <div class="two">${card('P/S (최근 4분기 매출 대비 시총)','',`<div class="ch-box"><canvas id="cPS"></canvas></div>`)}
 ${card('영업이익률','',`<div class="ch-box"><canvas id="cOPM"></canvas></div>`)}</div>
 ${card('검사별 비교','회사·IR·Grail/Guardant 공시 기준 · 연구 설계가 달라 직접 비교 아님',`<div class="tw"><table><thead><tr><th></th><th>아이캔서치 (지씨지놈)</th><th>Galleri (Grail)</th><th>Shield (가던트)</th><th>PancSight (지씨지놈·미국)</th></tr></thead><tbody>
 <tr><td>대상</td><td>10종 암(2028 20종)</td><td>50종 이상 + 발생 부위</td><td>대장암 1종(+MCD 10종 개발)</td><td>췌장암 1종</td></tr>
 <tr><td>방식</td><td>저밀도 전장 시퀀싱 + AI</td><td>표적 메틸화</td><td>메틸화·변이</td><td>cfDNA 조각 + 면역세포 유래 비율</td></tr>
 <tr><td>민감도 / 특이도</td><td>84.5% / 94.5%</td><td>35~40% / 99.6~99.85%(전향)</td><td>83% / 90%</td><td>1·2기 87.5% / 95.4%</td></tr>
 <tr><td>가격</td><td>국내 약 37만원 · 일본 ¥165,000</td><td>정가 $949</td><td>약 $1,000(회사 비교)</td><td>$1,000~1,200 목표</td></tr>
 <tr><td>연간 검사</td><td>2025 5,100 → 2026E 1.2만 건</td><td>2025 18.5만+ 건</td><td>2026E 27~28.5만 건</td><td>1H28 개시 목표</td></tr>
 <tr><td>규제</td><td>국내·일본 상용</td><td>LDT 판매, FDA 자문위 찬성 7·반대 2(9/23)</td><td>FDA 승인·메디케어 급여</td><td>BDD 신청 예정 → 27년 허가 목표</td></tr></tbody></table></div>`)}
 ${card('쓰리빌리언은 왜 같이 보나','',`<ul class="def"><li>사업은 다름: 쓰리빌리언은 AI로 희귀질환 유전체를 해석하는 서비스(해외 B2B 비중 높음), 지씨지놈은 검사실 기반 NIPT·암 검사</li><li>같은 '국내 상장 유전체' 바스켓으로 움직임: 상장 이후 일간 수익률 상관계수 0.39</li><li><b>GVA는 쓰리빌리언을 주식이 아닌 CB 25억 + 전환우선주 25억(전환가 12,501원)으로 보유</b>. 현재가 ${nf(6140)}원은 전환가의 절반 → 적자·고밸류 바이오는 조건으로 사는 하우스</li><li>지씨지놈은 흑자·순현금으로 같은 업종 안에서 '주식으로 살 수 있는' 쪽</li></ul>`)}
 </section>`;
 /* 미국·일본 */
 H+=`<section class="page" id="us"><div class="page-head"><h1>미국·일본</h1><p>가격에 0으로 둔 옵션</p></div>
 <div class="two">${card('일본 아이캔서치 매출 (억원)','2026 약 20억 예상, 2027 일본 매출 100억 목표(회사)',`<div class="ch-box"><canvas id="cJ"></canvas></div>`)}
 ${card('췌장암 조기진단 성능 비교','후향적 결과. 키움·삼성·컨콜 정리',`<div class="tw"><table><thead><tr><th>제품</th><th class="n">민감도</th><th class="n">특이도</th><th class="n">1/2기 민감도</th><th>상태</th></tr></thead><tbody>
 <tr><td><b>PancSight(지씨지놈)</b></td><td class="n">95.0%</td><td class="n">95.6%</td><td class="n"><b>87.5~91.7%</b></td><td>BDD 신청 예정</td></tr>
 <tr><td>PDACatch(S사)</td><td class="n">84.0%</td><td class="n">89.0%</td><td class="n">75.4%</td><td>2023 출시</td></tr>
 <tr><td>Avantect(C사)</td><td class="n">68.3%</td><td class="n">96.9%</td><td class="n">68.3%</td><td>2023 출시</td></tr>
 <tr><td>PancreaSure(Immunovia)</td><td class="n">-</td><td class="n">94%</td><td class="n">78%(고위험군)</td><td>2025.9 LDT, CMS $897</td></tr>
 <tr><td>Freenome(대장암)</td><td class="n">81%</td><td class="n">90.4%</td><td class="n">-</td><td>2026.7 FDA 승인</td></tr>
 <tr><td>메디케어 등재 기준</td><td class="n">74%</td><td class="n">90%</td><td class="n">-</td><td>회사가 들은 가이던스</td></tr></tbody></table></div>`)}</div>
 ${card('미국 구조: 지씨지놈 몫은 얼마인가','가장 많이 받을 질문',`<ul class="def">
 <li>미국 사업 주체는 관계사 <b>GC랩텍</b>(CLIA 실험실). 지씨지놈 지분 24.1% → 컨버터블 노트 전환 시 31%(내년 상반기), 지씨지놈은 로열티 수취</li>
 <li>최대주주 녹십자홀딩스 51% → 지씨지놈이 일부를 가져와 연결 편입하는 방안 논의, 연말 결정 예정</li>
 <li>유통: 가던트헬스와 계약 협의. 매출 배분 4:6(가던트:랩텍) 논의 중, 미확정</li>
 <li>회사 목표: 2028 $3,000만(대상 200만 명 × 채택률 1.5% × $1,000), 2030 $1억</li>
 <li>벤치마크: 가던트 쉴드 2024.9 출시 후 매출 급증, 가던트 시총 2년 만에 약 5조 → 30조원(컨콜 설명) / 그레일 Galleri 2Q26 6.1만 건(+35%), FDA 자문위 찬성 7·반대 2</li>
 <li class="up">리스크: 후향적 데이터 기준. 그레일은 전향적 연구에서 민감도가 최대 40% 떨어졌음(삼성)</li></ul>`)}
 </section>`;

 /* 허가·로열티 */
 H+=`<section class="page" id="reg"><div class="page-head"><h1>미국 허가 가능성과 로열티</h1><p>BDD 요건·2026년 사례·로열티와 지분법 손익 · 가능성 %와 로열티율은 내 추정</p></div>
 <div class="kpis">${kpi('BDD 지정 가능성','약 70%','요건 충족 쉬움, 비슷한 사례 다수','reg')}${kpi('FDA 판매 허가 27년 중순','10% 미만','전향 임상 없음 · Freenome은 4.8만 명','reg')}${kpi('2030 로열티(회사 목표·8%)','약 67억','2026E 영업이익 28억의 2.4배','reg')}${kpi('로열티 구조 시총 애드','+160~600억','성공확률 35% · 연결 편입 없을 때','dream')}</div>
